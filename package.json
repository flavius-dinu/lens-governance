{
  "name": "lens-governance",
  "version": "0.1.0",
  "description": "See what each service account may do, what admission policies require, and which pods can reach which, and try new policies before you apply them.",
  "keywords": [
    "lens-extension"
  ],
  "license": "MIT",
  "author": "Flavius Dinu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flavius-dinu/lens-governance.git"
  },
  "bugs": {
    "url": "https://github.com/flavius-dinu/lens-governance/issues"
  },
  "homepage": "https://github.com/flavius-dinu/lens-governance#readme",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md"
  ],
  "lensExtension": {
    "icon": "assets/icon.svg",
    "banner": "assets/banner.svg"
  },
  "scripts": {
    "build": "lens-css-module-types src && lens-types-check && lens-package-build --entry-point ./src/index.ts",
